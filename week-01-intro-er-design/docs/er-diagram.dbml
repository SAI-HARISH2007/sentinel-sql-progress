Table account_devices {
  account_id int
  device_id int
  first_seen timestamp [default: `now()`]
  last_seen timestamp [default: `now()`]

  indexes {
    (account_id, device_id) [pk]
  }
}

Table accounts {
  account_id int [pk, increment]
  user_id int [not null]
  account_type enum('savings','current') [not null, default: 'savings']
  balance decimal(14,2) [not null, default: 0.00]
  status enum('active','frozen','closed') [not null, default: 'active']
  created_at timestamp [default: `now()`]
}

Table alerts {
  alert_id bigint [pk, increment]
  txn_id bigint [not null, unique]
  rule_name varchar(50) [not null]
  risk_score decimal(5,2) [not null]
  reasons json
  status enum('open','investigated','confirmed','false_positive') [not null, default: 'open']
  created_at timestamp [default: `now()`]
  reviewed_at timestamp
}

Table audit_log {
  audit_id bigint [pk, increment]
  table_name varchar(100) [not null]
  record_id bigint [not null]
  action enum('INSERT','UPDATE','DELETE') [not null]
  old_value_json json
  new_value_json json
  changed_by varchar(100)
  changed_at timestamp [default: `now()`]
}

Table behaviour_baselines {
  baseline_id int [pk, increment]
  account_id int [not null, unique]
  avg_amount decimal(12,2)
  stddev_amount decimal(12,2)
  peak_hours_json json
  typical_cities_json json
  updated_at timestamp [default: `now()`]
}

Table devices {
  device_id int [pk, increment]
  device_type enum('mobile','desktop','tablet') [not null]
  os varchar(50)
  browser varchar(50)
  fingerprint_hash varchar(64) [not null, unique]
}

Table locations {
  location_id int [pk, increment]
  city varchar(100) [not null]
  state varchar(100)
  country varchar(100) [not null, default: 'India']
  latitude decimal(9,6) [not null]
  longitude decimal(9,6) [not null]
}

Table login_history {
  login_id bigint [pk, increment]
  account_id int [not null]
  device_id int [not null]
  location_id int [not null]
  login_time timestamp [default: `now()`]
  success tinyint(1) [not null, default: 1]
}

Table merchant_categories {
  category_id int [pk, increment]
  category_name varchar(100) [not null, unique]
  description text
}

Table merchants {
  merchant_id int [pk, increment]
  merchant_name varchar(200) [not null]
  category_id int [not null]
  city varchar(100) [not null]
  latitude decimal(9,6) [not null]
  longitude decimal(9,6) [not null]
  risk_score decimal(5,2) [default: 0.00]
}

Table rule_config {
  rule_id int [pk, increment]
  rule_name varchar(50) [not null, unique]
  enabled tinyint(1) [not null, default: 1]
  threshold_value decimal(12,4) [not null]
  parameters_json json
  updated_at timestamp [default: `now()`]
}

Table transactions {
  txn_id bigint [pk, increment]
  account_id int [not null]
  merchant_id int [not null]
  device_id int [not null]
  location_id int [not null]
  amount decimal(12,2) [not null]
  txn_time timestamp [not null, default: `now()`]
  status enum('success','pending','failed') [not null, default: 'success']
  metadata_json json
}

Table users {
  user_id int [pk, increment]
  full_name varchar(150) [not null]
  email varchar(255) [not null, unique]
  phone varchar(20)
  date_of_birth date
  created_at timestamp [default: `now()`]
}

